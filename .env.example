SOCKET_PORT=5000
# Standalone socket deploy (Render): Root Directory = socket-server/.
# SOCKET_CORS_ORIGIN is preferred (comma-separated); SOCKET_URL is legacy single-origin.
# SOCKET_INTERNAL_SECRET must be set in production (same value on Vercel + Render).
# SOCKET_INTERNAL_URL (Vercel server) and NEXT_PUBLIC_SOCKET_URL (browser) point at the Render URL.
SOCKET_CORS_ORIGIN=
SOCKET_URL=
SOCKET_INTERNAL_SECRET=
SOCKET_INTERNAL_URL=
NEXT_PUBLIC_SOCKET_URL=
BETTER_AUTH_SECRET
# Production URL (Vercel). Use http://localhost:3000 for local development.
BETTER_AUTH_URL=https://home-service-management-main.vercel.app
# Public app URL used for links in emails (falls back to BETTER_AUTH_URL if unset).
NEXT_PUBLIC_APP_URL=https://home-service-management-main.vercel.app
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
DATABASE_URL
# Optional: direct (non-pooled) connection for drizzle-kit migrations.
# Defaults to DATABASE_URL with "-pooler" stripped.
DIRECT_DATABASE_URL
# Gmail SMTP (nodemailer) — create a Google App Password (2FA required).
# GMAIL_USER is the sender address; prefer GMAIL_APP_PASSWORD, GMAIL_PASSWORD also works.
GMAIL_USER
GMAIL_APP_PASSWORD
GMAIL_PASSWORD
EMAIL_FROM
# Cloudinary signed direct uploads (browser -> Cloudinary, server only signs params).
# CLOUD_NAME is public; API_KEY/SECRET stay server-only. No unsigned preset is used.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET
# Razorpay (test mode) — Route marketplace split. KEY_ID is exposed to the
# browser via server action for Checkout; KEY_SECRET stays server-only.
RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET